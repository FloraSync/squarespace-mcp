# Local stdio transport
SQUARESPACE_API_KEY=

# HTTP authentication: insecure-env (default) or secure-sqlite
AUTHMODE=insecure-env
MCPAPIKEY=

# Secure HTTP authentication
SQLITEDBPATH=/data/squarespace-mcp.sqlite
INITAPIKEY=
MASTERENCRYPTIONKEY=

# Remote HTTP transport
MCP_PUBLIC_URL=https://your-service.example/mcp
SQUARESPACE_API_KEY=

# Safe by default. Set false or use --read-write to enable write tools.
SQUARESPACE_MCP_READ_ONLY=true
