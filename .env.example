# Squarespace MCP configuration (load these variables into the process environment).

# Local stdio, or the shared outbound credential in API-key HTTP modes.
# OAuth HTTP mode receives a separate Squarespace credential from each user at login.
SQUARESPACE_API_KEY=
# SQUARESPACE_ACCESS_TOKEN=  # Alternative; required for webhook subscriptions.

# HTTP authentication: oauth, insecure-env, or secure-sqlite.
# With AUTHMODE unset, MCP_TOKEN_SECRET selects oauth; otherwise insecure-env.
AUTHMODE=oauth
MCP_PUBLIC_URL=https://your-service.example/mcp

# OAuth HTTP mode: random 32+ character encryption secret.
# Generate with: openssl rand -base64 32
MCP_TOKEN_SECRET=

# insecure-env HTTP mode: separate inbound MCP bearer key (not a Squarespace key).
MCPAPIKEY=

# secure-sqlite HTTP mode: persistent storage and first-boot admin bearer key.
SQLITEDBPATH=/data/squarespace-mcp.sqlite
INITAPIKEY=
# Required only when using the OAuthSessionStore encryption helper.
MASTERENCRYPTIONKEY=

# Optional HTTP port (Cloud Run supplies PORT).
# PORT=3000

# Set false or use --read-write to expose operations that modify the store.
SQUARESPACE_MCP_READ_ONLY=true
