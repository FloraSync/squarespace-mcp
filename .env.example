# ==============================================================================
# Squarespace MCP Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Stdio Mode (Claude Desktop, Cursor, Gemini CLI)
# ------------------------------------------------------------------------------
# Your Squarespace Developer API Key (Settings -> Developer Tools -> Developer API Keys)
# Required for local use (unless SQUARESPACE_ACCESS_TOKEN is supplied)
SQUARESPACE_API_KEY=

# Optional: Squarespace OAuth Access Token (required if managing webhook subscriptions)
# SQUARESPACE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 2. Remote HTTP Mode (Gemini Spark, Google Cloud Run)
# ------------------------------------------------------------------------------
# The exact public HTTPS endpoint where this server is reachable, ending in /mcp
# Example: https://squarespace-mcp-xyz-uc.a.run.app/mcp
MCP_PUBLIC_URL=https://your-service.example/mcp

# A random 32+ character string used to encrypt session tokens (AES-256-GCM)
# Generate one in your terminal with: openssl rand -base64 32
MCP_TOKEN_SECRET=

# Optional: Custom HTTP port (defaults to 3000, or provided by Cloud Run $PORT)
# PORT=3000

# ------------------------------------------------------------------------------
# 3. Safety & Permissions
# ------------------------------------------------------------------------------
# Safe by default! When true, only read-only operations are exposed to the AI.
# Set to 'false' (or pass --read-write flag) if you want the AI to create or update
# products, stock levels, orders, or discounts.
SQUARESPACE_MCP_READ_ONLY=true
